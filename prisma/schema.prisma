generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

enum ChallengeAttemptStatus {
  STARTED
  PASSED
  FAILED
  ABANDONED
}

enum AchievementStatus {
  LOCKED
  IN_PROGRESS
  UNLOCKED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           UserProfile?
  lessonProgress    UserLessonProgress[]
  stageProgress     UserStageProgress[]
  challengeAttempts UserChallengeAttempt[]
  achievements      UserAchievement[]
  feedback          Feedback[]
}

model Feedback {
  id        String   @id @default(cuid())
  type      String
  message   String
  email     String?
  userId    String?
  page      String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  initials      String?
  nativeLocale  String   @default("en")
  targetLocale  String   @default("ru")
  level         Int      @default(1)
  totalXp       Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  hearts        Int      @default(5)
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model World {
  id          String        @id @default(cuid())
  slug        String        @unique
  number      Int           @unique
  title       String
  subtitle    String?
  description String
  xpReward    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stages     Stage[]
  lessons    Lesson[]
  challenges Challenge[]
}

model Stage {
  id          String        @id @default(cuid())
  worldId     String
  slug        String
  number      Int
  title       String
  description String
  xpReward    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  isBossStage Boolean       @default(false)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  world        World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  challenges   Challenge[]
  userProgress UserStageProgress[]

  @@unique([worldId, slug])
  @@unique([worldId, number])
  @@index([worldId])
}

model Lesson {
  id          String        @id @default(cuid())
  worldId     String
  stageId     String
  slug        String
  number      Int
  title       String
  description String
  xpReward    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  vocabulary  Json?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  world        World                @relation(fields: [worldId], references: [id], onDelete: Cascade)
  stage        Stage                @relation(fields: [stageId], references: [id], onDelete: Cascade)
  exercises    Exercise[]
  userProgress UserLessonProgress[]

  @@unique([worldId, slug])
  @@unique([stageId, number])
  @@index([worldId])
  @@index([stageId])
}

model Exercise {
  id          String        @id @default(cuid())
  lessonId    String
  slug        String
  type        String
  prompt      String
  content     Json
  answerKey   Json
  explanation String?
  points      Int           @default(0)
  order       Int
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, slug])
  @@unique([lessonId, order])
  @@index([lessonId])
}

model Challenge {
  id          String        @id @default(cuid())
  worldId     String
  stageId     String?
  slug        String
  title       String
  description String
  type        String
  xpReward    Int           @default(0)
  passScore   Int?
  content     Json
  status      ContentStatus @default(DRAFT)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  world    World                  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  stage    Stage?                 @relation(fields: [stageId], references: [id], onDelete: SetNull)
  attempts UserChallengeAttempt[]

  @@unique([worldId, slug])
  @@index([worldId])
  @@index([stageId])
}

model UserLessonProgress {
  id            String         @id @default(cuid())
  userId        String
  lessonId      String
  status        ProgressStatus @default(LOCKED)
  xpEarned      Int            @default(0)
  bestScore     Int?
  attempts      Int            @default(0)
  lastStartedAt DateTime?
  completedAt   DateTime?
  state         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId, status])
}

model UserStageProgress {
  id          String         @id @default(cuid())
  userId      String
  stageId     String
  status      ProgressStatus @default(LOCKED)
  xpEarned    Int            @default(0)
  completedAt DateTime?
  state       Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
  @@index([stageId])
  @@index([userId, status])
}

model UserChallengeAttempt {
  id          String                 @id @default(cuid())
  userId      String
  challengeId String
  status      ChallengeAttemptStatus @default(STARTED)
  score       Int                    @default(0)
  xpEarned    Int                    @default(0)
  heartsLeft  Int?
  answers     Json?
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
  @@index([challengeId])
  @@index([userId, status])
}

model Achievement {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  xpReward    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  criteria    Json?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users UserAchievement[]
}

model UserAchievement {
  id            String            @id @default(cuid())
  userId        String
  achievementId String
  status        AchievementStatus @default(LOCKED)
  progress      Json?
  unlockedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
  @@index([userId, status])
}
