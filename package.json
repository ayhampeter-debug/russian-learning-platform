{
  "name": "russian-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "qa:body-parts": "node scripts/qa-body-parts.mjs",
    "qa:screenshots": "npm run qa:body-parts",
    "db:ping": "node scripts/db-ping.mjs",
    "db:disable-user-rls": "node scripts/db-maintenance.mjs disable-user-rls",
    "db:check-user-rls": "node scripts/db-maintenance.mjs check-user-rls",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:seed:sql": "node --experimental-strip-types prisma/generate-seed-sql.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
